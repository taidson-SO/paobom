# PaoBom ERP - local environment example
#
# Copy this file to .env when real services are introduced.
# The current mock MVP does not require these variables at runtime.

NODE_ENV=development

# Shared API configuration for future backend integration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# PostgreSQL local service prepared for the persistence phase.
POSTGRES_DB=paobom
POSTGRES_USER=paobom
POSTGRES_PASSWORD=paobom
POSTGRES_PORT=5432
DATABASE_URL=postgresql://paobom:paobom@localhost:5432/paobom?schema=public

# Optional local database administration UI.
PGADMIN_DEFAULT_EMAIL=admin@paobom.local
PGADMIN_DEFAULT_PASSWORD=paobom
PGADMIN_PORT=5050
