# PaoBom ERP - staging environment example
#
# Copy this file to .env.staging before running staging commands.
# This file is intentionally safe for local/staging simulation only.

NODE_ENV=staging

STAGING_NODE_UID=1000
STAGING_NODE_GID=1000

STAGING_POSTGRES_DB=paobom_staging
STAGING_POSTGRES_USER=paobom_staging
STAGING_POSTGRES_PASSWORD=paobom_staging
STAGING_POSTGRES_PORT=55432

STAGING_API_PORT=3335
STAGING_WEB_PORT=3001
STAGING_PUBLIC_API_BASE_URL=http://localhost:3335
STAGING_CORS_ORIGIN=http://localhost:3001
STAGING_AUTH_TOKEN_SECRET=change-me-staging-secret
STAGING_SESSION_TTL_HOURS=12
STAGING_SESSION_MAX_ACTIVE=5
STAGING_SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Required. Use a controlled staging password; the staging seed refuses the
# local development default unless ALLOW_DEFAULT_SEED_PASSWORD=true is set.
STAGING_SEED_USER_PASSWORD=

STAGING_PGADMIN_EMAIL=admin-staging@paobom.local
STAGING_PGADMIN_PASSWORD=paobom-staging
STAGING_PGADMIN_PORT=5051
