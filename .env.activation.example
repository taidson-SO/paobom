# Copy to .env.activation and keep it only on the operator workstation.

# VPS
STAGING_HOST=203.0.113.10
STAGING_SSH_PORT=22
STAGING_USER=paobom-deploy
STAGING_DEPLOY_PATH=/opt/paobom
VPS_BOOTSTRAP_USER=root
# Optional when the bootstrap user does not use the SSH agent.
VPS_BOOTSTRAP_SSH_KEY=
# Optional but recommended: fingerprint shown by the VPS provider console.
VPS_SSH_HOST_FINGERPRINT=

# Public endpoints
STAGING_WEB_DOMAIN=staging.example.com
STAGING_API_DOMAIN=api.staging.example.com
STAGING_GRAFANA_DOMAIN=metrics.staging.example.com
ACME_EMAIL=ops@example.com
ALERT_WEBHOOK_URL=https://alerts.example.com/paobom

# DNS provider: manual or cloudflare
DNS_PROVIDER=manual
DNS_PROXIED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# GitHub
GITHUB_REPOSITORY=owner/paobom
GITHUB_ENVIRONMENT=staging
GITHUB_DEPLOY_BRANCH=main
STAGING_GHCR_USER=owner
# Fine-grained token or classic PAT with read:packages.
STAGING_GHCR_TOKEN=

# Controlled smoke-test user created by the staging seed.
STAGING_SMOKE_EMAIL=dono@paobom.local
