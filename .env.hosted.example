# Copy to .env.hosted only on the staging host or store the complete content in
# the GitHub Actions secret STAGING_ENV_FILE.

APP_ENV=staging

STAGING_WEB_DOMAIN=staging.example.com
STAGING_API_DOMAIN=api.staging.example.com
STAGING_GRAFANA_DOMAIN=metrics.staging.example.com
ACME_EMAIL=ops@example.com

STAGING_API_IMAGE=ghcr.io/owner/paobom-api:staging
STAGING_WEB_IMAGE=ghcr.io/owner/paobom-web:staging

POSTGRES_DB=paobom_staging
POSTGRES_USER=paobom_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://paobom_staging:replace-with-a-long-random-password@postgres:5432/paobom_staging?schema=public

AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
SESSION_MAX_ACTIVE=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
SEED_USER_PASSWORD=replace-with-a-controlled-staging-password

GRAFANA_ADMIN_USER=paobom-ops
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
ALERT_WEBHOOK_URL=https://alerts.example.com/paobom
