generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductUnit {
  kg
  g
  ml
  unit
  liter
  package
}

enum ProductKind {
  raw_material
  finished_product
  resale
  packaging
}

enum PurchaseStatus {
  draft
  ordered
  received
  cancelled
}

enum StockMovementType {
  purchase_in
  purchase_reversal
  production_out
  production_in
  production_reversal
  sale_out
  sale_reversal
  loss
  adjustment
}

enum StockMovementOrigin {
  opening_balance
  purchase
  production
  sale
  loss
  manual_adjustment
  return
}

enum ProductionOrderStatus {
  planned
  started
  finished
  cancelled
}

enum SaleStatus {
  open
  paid
  cancelled
}

enum PaymentMethod {
  cash
  card
  pix
  invoice
}

enum CashEntryType {
  income
  expense
}

enum CashEntryStatus {
  pending
  settled
  cancelled
}

enum CashRegisterStatus {
  open
  closed
}

enum UserRole {
  owner
  manager
  cashier
  baker
  stock
  sales
  viewer
}

enum AuditActionResult {
  success
  failure
}

model Product {
  id                     String                  @id @default(uuid())
  name                   String
  sku                    String                  @unique
  kind                   ProductKind
  unit                   ProductUnit
  category               String
  purchasePrice          Decimal                 @db.Decimal(12, 2)
  salePrice              Decimal                 @db.Decimal(12, 2)
  minimumStock           Decimal                 @db.Decimal(12, 3)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  purchaseItems          PurchaseItem[]
  stockMovements         StockMovement[]
  inventoryLots          InventoryLot[]
  physicalInventoryCounts PhysicalInventoryCount[]
  inventoryBalance       InventoryBalance?
  recipeOutputs          Recipe[]                @relation("RecipeOutputProduct")
  recipeIngredients      RecipeIngredient[]
  productionOutputs      ProductionOrder[]
  productionConsumptions ProductionConsumption[]
  saleItems              SaleItem[]

  @@index([kind, active])
  @@index([category])
  @@map("products")
}

model Supplier {
  id          String     @id @default(uuid())
  name        String
  document    String
  contactName String
  phone       String
  email       String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
  inventoryLots InventoryLot[]

  @@unique([document])
  @@index([active])
  @@map("suppliers")
}

model Customer {
  id           String                @id @default(uuid())
  name         String
  document     String
  phone        String
  email        String
  notes        String
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  sales        Sale[]
  interactions CustomerInteraction[]

  @@index([document])
  @@index([active])
  @@map("customers")
}

model CustomerInteraction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  description String
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId, occurredAt])
  @@map("customer_interactions")
}

model Purchase {
  id           String         @id @default(uuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  expectedDate DateTime
  status       PurchaseStatus @default(draft)
  notes        String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  receivedAt   DateTime?
  items        PurchaseItem[]
  inventoryLots InventoryLot[]

  @@index([supplierId])
  @@index([status])
  @@index([expectedDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryBalance {
  productId    String   @id
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Decimal  @db.Decimal(12, 3)
  averageCost  Decimal  @db.Decimal(12, 2)
  minimumStock Decimal  @db.Decimal(12, 3)
  updatedAt    DateTime @updatedAt

  @@map("inventory_balances")
}

model StockMovement {
  id          String              @id @default(uuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id])
  lotId       String?
  lot         InventoryLot?       @relation(fields: [lotId], references: [id])
  type        StockMovementType
  origin      StockMovementOrigin
  quantity    Decimal             @db.Decimal(12, 3)
  unitCost    Decimal             @db.Decimal(12, 2)
  reason      String
  referenceId String?
  occurredAt  DateTime
  createdAt   DateTime            @default(now())

  @@index([productId, occurredAt])
  @@index([lotId])
  @@index([type])
  @@index([origin])
  @@index([referenceId])
  @@map("stock_movements")
}

model InventoryLot {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  lotCode        String
  quantity       Decimal         @db.Decimal(12, 3)
  unitCost       Decimal         @db.Decimal(12, 2)
  expirationDate DateTime?
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  purchaseId     String?
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id])
  receivedAt     DateTime
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  movements      StockMovement[]

  @@unique([productId, lotCode])
  @@index([productId, status])
  @@index([expirationDate])
  @@index([supplierId])
  @@index([purchaseId])
  @@map("inventory_lots")
}

model PhysicalInventoryCount {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  expectedQuantity   Decimal  @db.Decimal(12, 3)
  countedQuantity    Decimal  @db.Decimal(12, 3)
  divergenceQuantity Decimal  @db.Decimal(12, 3)
  reason             String?
  countedBy          String
  countedAt          DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([productId, countedAt])
  @@index([countedAt])
  @@map("physical_inventory_counts")
}

model Recipe {
  id              String             @id @default(uuid())
  name            String
  version         Int
  outputProductId String
  outputProduct   Product            @relation("RecipeOutputProduct", fields: [outputProductId], references: [id])
  yieldQuantity   Decimal            @db.Decimal(12, 3)
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  ingredients     RecipeIngredient[]
  productionOrders ProductionOrder[]

  @@unique([name, version])
  @@index([outputProductId, active])
  @@map("recipes")
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)

  @@index([recipeId])
  @@index([productId])
  @@map("recipe_ingredients")
}

model ProductionOrder {
  id                     String                  @id @default(uuid())
  recipeId               String
  recipe                 Recipe                  @relation(fields: [recipeId], references: [id])
  recipeSnapshot         Json
  outputProductId        String
  outputProduct          Product                 @relation(fields: [outputProductId], references: [id])
  quantityProduced       Decimal                 @db.Decimal(12, 3)
  status                 ProductionOrderStatus   @default(planned)
  notes                  String
  createdAt              DateTime                @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  ingredientConsumptions ProductionConsumption[]

  @@index([recipeId])
  @@index([outputProductId])
  @@index([status])
  @@index([createdAt])
  @@map("production_orders")
}

model ProductionConsumption {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Decimal         @db.Decimal(12, 3)
  unitCost          Decimal         @db.Decimal(12, 2)

  @@index([productionOrderId])
  @@index([productId])
  @@map("production_consumptions")
}

model Sale {
  id                    String        @id @default(uuid())
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id])
  status                SaleStatus    @default(open)
  paymentMethod         PaymentMethod
  discountAmount        Decimal       @db.Decimal(12, 2)
  discountAuthorizedBy  String?
  discountReason        String?
  oversellApprovedBy    String?
  oversellJustification String?
  notes                 String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paidAt                DateTime?
  items                 SaleItem[]

  @@index([customerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model CashEntry {
  id          String          @id @default(uuid())
  type        CashEntryType
  status      CashEntryStatus @default(pending)
  category    String
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  settledAt   DateTime?
  referenceId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([settledAt])
  @@index([referenceId])
  @@map("cash_entries")
}

model CashRegister {
  id               String             @id @default(uuid())
  status           CashRegisterStatus @default(open)
  openingAmount    Decimal            @db.Decimal(12, 2)
  openedAt         DateTime
  openedBy         String
  closedAt         DateTime?
  closedBy         String?
  countedAmount    Decimal?           @db.Decimal(12, 2)
  expectedAmount   Decimal?           @db.Decimal(12, 2)
  differenceAmount Decimal?           @db.Decimal(12, 2)
  closingNote      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([openedAt])
  @@map("cash_registers")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]

  @@index([role])
  @@index([active])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id          String            @id @default(uuid())
  action      String
  entity      String
  entityId    String?
  userId      String
  userName    String
  userRole    String
  result      AuditActionResult
  description String
  metadata    Json
  occurredAt  DateTime
  createdAt   DateTime          @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([occurredAt])
  @@map("audit_logs")
}
