{
  "name": "paobom",
  "private": true,
  "version": "1.0.0",
  "description": "Erp para panificadoras",
  "scripts": {
    "dev": "turbo dev",
    "dev-api": "turbo dev --filter=api",
    "dev-web": "turbo dev --filter=web",
    "dev-mobile": "turbo dev --filter=mobile",
    "staging:up": "docker compose --env-file .env.staging -f docker-compose.staging.yml up -d postgres api web",
    "staging:seed": "docker compose --env-file .env.staging -f docker-compose.staging.yml run --rm staging-seed",
    "staging:down": "docker compose --env-file .env.staging -f docker-compose.staging.yml down",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait postgres-e2e",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:local": "bash scripts/run-e2e-local.sh",
    "db:deploy": "pnpm --filter @paobom/database db:deploy",
    "db:generate": "pnpm --filter @paobom/database db:generate",
    "db:migrate": "pnpm --filter @paobom/database db:migrate",
    "db:seed": "pnpm --filter @paobom/database db:seed",
    "db:seed:staging": "pnpm --filter @paobom/database db:seed:staging",
    "db:studio": "pnpm --filter @paobom/database db:studio",
    "db:validate": "pnpm --filter @paobom/database db:validate",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint"
  },
  "keywords": ["erp", "panificadora", "software", "gestão", "vendas", "estoque", "financeiro", "relatórios"],
  "author": "Taidson Silva",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}
